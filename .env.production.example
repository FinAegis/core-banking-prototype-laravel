# =============================================================================
# FinAegis — Production Environment (.env.production.example)
# =============================================================================
# This template is for deploying FinAegis as a PRODUCTION mobile backend.
# Copy to .env and fill in your values.
#
# Key difference from .env.example: APP_ENV=production disables the
# DemoServiceProvider, which means ALL service bindings (wallet balances,
# payments, transaction approvals, bundlers) use REAL implementations.
#
# For the demo/showcase site (finaegis.org), use .env.example with APP_ENV=demo.
# The demo-only ledger features (LEDGER_DIRECT_FUNDING_ENABLED,
# CARDS_WAITLIST_DEPOSIT_ENABLED, INVESTOR_PAGE_ENABLED, the account.create /
# payment.transfer / exchange.trade MCP tools) default to OFF under
# APP_ENV=production; a demo that runs APP_ENV=production must set them to
# true explicitly. The mock custodian is never available in production.
#
# Also OFF by default under APP_ENV=production (unset): TRADING_ENABLED,
# SMS_ENABLED, RELAYER_GENERIC_SPONSOR_ENABLED, REGISTRATION_API_ENABLED and
# ADMIN_RUNTIME_MANAGEMENT_ENABLED. These switches are ON by default only for
# APP_ENV=local, testing or demo; any other APP_ENV (staging included) gets
# the production defaults.
# REGISTRATION_API_ENABLED unset CLOSES NEW SIGN-UPS from the mobile app
# (password register and first Privy login answer 403 ERR_REG_001; existing
# users keep logging in), so ops:verify-env FAILS a production deploy that
# does not set it. Set it to true or false — see the REGISTRATION section.
#
# SET EXPLICITLY for every production deployment (no safe implicit value
# for a customer install): TRADING_ENABLED, MODULES_DISABLED,
# MOBILE_FEATURE_GCU_TRADING and SHOW_PROMO_PAGES. See the BRANDING and
# MOBILE sections below.
# =============================================================================

APP_NAME=FinAegis
APP_BRAND=zelta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Leave LOG_STACK unset: it defaults to "daily" and auto-adds "slack" when
# LOG_SLACK_WEBHOOK_URL is set. An explicit LOG_STACK overrides the default.
#LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Setting LOG_SLACK_WEBHOOK_URL auto-enables Slack alerting for critical logs
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="Zelta Ops"
LOG_SLACK_EMOJI=:rotating_light:
LOG_SLACK_LEVEL=critical

# =============================================================================
# DEMO MODE — ALL DISABLED FOR PRODUCTION
# =============================================================================
DEMO_INSTANT_DEPOSITS=false
DEMO_SKIP_KYC=false
DEMO_MOCK_BANKS=false
DEMO_MOCK_EXTERNAL_APIS=false
DEMO_FAKE_BLOCKCHAIN=false
DEMO_FIXED_EXCHANGE_RATES=false
DEMO_AUTO_APPROVE=false
DEMO_AUTO_APPROVE_TRANSACTIONS=false
DEMO_DEFAULT_DEPOSIT_AMOUNT=0
DEMO_DEFAULT_CURRENCY=USD
DEMO_PROCESSING_DELAY=0
DEMO_SUCCESS_RATE=100
DEMO_SHOW_BANNER=false
DEMO_BANNER_MESSAGE=""
DEMO_BANNER_COLOR=info
DEMO_WATERMARK=false
DEMO_AUTO_CREATE_USERS=false
DEMO_DEFAULT_BALANCE=0
DEMO_KYC_STATUS=pending
DEMO_ENFORCE_DB=false
DEMO_DISABLE_EXTERNAL_APIS=false
DEMO_DATA_RETENTION_DAYS=365
DEMO_MAX_ACCOUNTS=0
DEMO_CLEANUP_ENABLED=false
DEMO_SANDBOX_ENABLED=false

# =============================================================================
# DATABASE
# =============================================================================
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finaegis
DB_USERNAME=
DB_PASSWORD=

# =============================================================================
# SESSION / CACHE / QUEUE
# =============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Nightly DB backup destination (spatie/laravel-backup; backup:run --only-db
# at 01:30 UTC, backup:clean at 02:30 UTC — see routes/console.php).
# Production should NOT keep dumps on the local box: set BACKUP_DISK=s3 and
# configure the AWS_* bucket credentials below, then run one restore drill.
BACKUP_DISK=local
# BACKUP_DISK=s3
# Optional zip password for backup archives (AES encryption):
# BACKUP_ARCHIVE_PASSWORD=
# Local retention (backup:clean). Defaults: all dumps for 7 days, then one per
# day for 16 days, one per week for 8 weeks, one per month for 4 months, one per
# year for 2 years, capped at 5000 MB. The newest dump is never deleted. A host
# with disk-level backups can keep only recent dumps, for example:
# BACKUP_KEEP_ALL_DAYS=2
# BACKUP_KEEP_DAILY_DAYS=0
# BACKUP_KEEP_WEEKLY_WEEKS=0
# BACKUP_KEEP_MONTHLY_MONTHS=0
# BACKUP_KEEP_YEARLY_YEARS=0
# BACKUP_MAX_MEGABYTES=5000

CACHE_STORE=redis
CACHE_PREFIX=finaegis_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# =============================================================================
# MAIL
# =============================================================================
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=
# Plan B Slice 4 — operator email for cue DLQ digest (Backend-Q8 OD-3)
# Leave empty to fall back to Filament-only alerting.
MAIL_ADMIN_ADDRESS=

# =============================================================================
# BRANDING
# =============================================================================
BRAND_SUPPORT_EMAIL=support@zelta.app
BRAND_LEGAL_EMAIL=legal@zelta.app
BRAND_PRIVACY_EMAIL=privacy@zelta.app
BRAND_LEGAL_ENTITY=Zelta
BRAND_LEGAL_JURISDICTION=
BRAND_LEGAL_COMPANY_CODE=
BRAND_LEGAL_VAT_CODE=
BRAND_LEGAL_ADDRESS=
BRAND_GITHUB_URL=
GOOGLE_ANALYTICS_ID=

# Hide open-source marketing pages (/about, /pricing, /security, etc.) when
# this deployment is a customer-facing product rather than the FinAegis demo.
# FinAegis demo site (finaegis.org): leave true. Customer/Zelta install: false.
# SET EXPLICITLY for every production deployment.
SHOW_PROMO_PAGES=false

# Admin panel — visible module groups (comma-separated). Empty = show all
# (FinAegis full platform). For Zelta-style restricted view, use:
# ADMIN_MODULES="System,Mobile,Relayer,TrustCert,Banking,AI Agents,Commerce,Mobile Payments,Privacy,Fraud Detection,Key Management"
ADMIN_MODULES=

# Domain API surface (config/modules.php). Comma-separated domain list whose
# app/Domain/{Name}/Routes/api.php files are NOT loaded; routes/console.php
# also skips the listed domains' demo cron jobs (GCU voting, basket
# rebalancing, CGO payment checks), and the listed domains' GraphQL queries
# and mutations answer "This operation is not available.". Accepts bare
# directory names or finaegis/{name}, case-insensitive. Routes, GraphQL and
# demo cron only — service providers and queue workers still boot. Empty
# (default) = every domain loads (full FinAegis platform). For a
# mobile-wallet-only deployment use the curated list from .env.zelta.example
# (per-domain reasoning documented there).
# SET EXPLICITLY: an empty value is a deliberate "full platform" choice.
# MODULES_DISABLED="Banking,Basket,Cgo,CrossChain,DeFi,FinancialInstitution,Governance,ISO20022,ISO8583,Interledger,Ledger,Lending,Microfinance,OpenBanking,PaymentRails,Stablecoin,Treasury"
MODULES_DISABLED=

# Runtime module and plugin management by admins (config/modules.php
# runtime_management_enabled): POST /api/v2/modules/{name}/enable|disable|
# verify, the /api/v2/plugins discover/enable/disable/delete/scan endpoints,
# the GraphQL enablePlugin/disablePlugin/scanPlugin mutations and the admin
# panel Modules / Plugin Marketplace enable, disable and discover actions.
# A runtime module change writes the cache key domain_manager_disabled,
# which the module route loader prefers over MODULES_DISABLED. Unset = OFF
# under APP_ENV=production (the REST endpoints answer 404, the mutations
# return "This operation is not available."). Set true only where admins
# should change the module set without a deploy.
ADMIN_RUNTIME_MANAGEMENT_ENABLED=false

# Demo trading engine (config/trading.php). false stops the liquidity-pool
# cron jobs (rewards, rebalancing, market making) and closes the order-book /
# liquidity API, the web /exchange and /liquidity pages and GraphQL
# placeOrder. Unset = OFF under APP_ENV=production (ON for other
# environments). SET EXPLICITLY: false for a wallet deployment, true only
# for a deployment that runs the trading showcase.
TRADING_ENABLED=false
#
# Set explicitly together with TRADING_ENABLED: MODULES_DISABLED above,
# SHOW_PROMO_PAGES (BRANDING) and MOBILE_FEATURE_GCU_TRADING (MOBILE; false
# when Basket is disabled or trading is off, otherwise the app advertises a
# GCU trading feature the backend does not serve).

# Feature flags for demo-only ledger features. Secure by default: unset =
# OFF under APP_ENV=production or staging (ON for demo/local/testing), so a
# production deployment needs no lines here. The explicit false values below
# only document the intent; set a flag to true to opt a feature back in
# (e.g. INVESTOR_PAGE_ENABLED=true to serve /invest). CUSTODIAN_MOCK_ENABLED
# is ignored in production (the mock custodian is never registered there).
# Per-flag reasoning: .env.zelta.example (PRODUCTION KILL-SWITCHES).
# LEDGER_DIRECT_FUNDING_ENABLED=false
# With APP_ENV=production, LEDGER_DIRECT_FUNDING_ENABLED=true fails
# ops:verify-env unless LEDGER_DIRECT_FUNDING_ACKNOWLEDGED=true confirms it.
# LEDGER_DIRECT_FUNDING_ACKNOWLEDGED=false
# CUSTODIAN_MOCK_ENABLED=false
# CARDS_WAITLIST_DEPOSIT_ENABLED=false
# INVESTOR_PAGE_ENABLED=false
# Web wallet card deposits (/wallet/deposit/card) are payment-backed and do
# not depend on LEDGER_DIRECT_FUNDING_ENABLED. Unset, they are on only with
# HYPERSWITCH_ENABLED=true; set WEB_CARD_DEPOSITS_ENABLED=true for plain
# Stripe card deposits. Paysera deposits follow PAYSERA_ENABLED and need
# Paysera's server notification to reach /api/webhooks/paysera/deposit.
# WEB_CARD_DEPOSITS_ENABLED=false

# =============================================================================
# REGISTRATION (config/registration.php)
# =============================================================================
# REGISTRATION_API_ENABLED governs every API path that creates a NEW user:
# POST /api/auth/register and /api/v2/auth/register, the first login of a
# new Privy identity (mobile /api/v1/auth/privy-login, web /login/privy) and
# the first social login. Unset = OFF under APP_ENV=production: those
# requests answer 403 {error: {code: ERR_REG_001, reason:
# REGISTRATION_CLOSED}} and the mobile app shows the backend error. Existing
# users are never affected. Set true to accept sign-ups.
# REGISTRATION_API_INVITE_ONLY=true (with REGISTRATION_API_ENABLED=true)
# admits only emails with a pending admin invitation (Admin -> invitations,
# /invitation/accept flow); others get 403 ERR_REG_002 / INVITATION_REQUIRED.
# Password sign-up (POST /api/auth/register) must also send the invitation
# link's token as invitation_token; Privy uses the Privy-verified email.
# Not affected: admin web invitations, business team members added by an
# existing owner, CLI user:create / account:provision-reviewer.
# This template keeps the secure default (false). .env.zelta.example sets
# REGISTRATION_API_ENABLED=true because API sign-ups are open for zelta.app.
REGISTRATION_API_ENABLED=false
REGISTRATION_API_INVITE_ONLY=false

# =============================================================================
# SECURITY
# =============================================================================
FORCE_HTTPS=true
CORS_LOCAL_ORIGINS=
CORS_PRODUCTION_ORIGINS=https://zelta.app,https://www.zelta.app,https://api.zelta.app
CSP_API_ENDPOINT=https://api.your-domain.com
CSP_WS_ENDPOINT=wss://ws.your-domain.com

# GraphQL: disable schema introspection in production (config/lighthouse.php
# security.disable_introspection). Clients with the schema baked in are
# unaffected; this only blocks anonymous schema discovery.
LIGHTHOUSE_SECURITY_DISABLE_INTROSPECTION=true

# Comma-separated operator emails whose staff roles php artisan user:audit-staff-roles does not flag.
STAFF_ROLE_ALLOWLIST=

# Sanctum Token Expiration (minutes, 1440 = 24 hours)
SANCTUM_TOKEN_EXPIRATION=1440

# Metrics endpoint gate (/api/monitoring/{metrics,prometheus}, /api/metrics/prometheus).
# Bearer token for the Prometheus scraper; required in production (403 otherwise)
METRICS_TOKEN=
# Optional comma-separated IP allowlist as an alternative to the bearer token
METRICS_ALLOWED_IPS=

# =============================================================================
# MOBILE APP
# =============================================================================
FIREBASE_CREDENTIALS=storage/firebase-credentials.json
FIREBASE_PROJECT_ID=

MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false
MOBILE_MAX_DEVICES=5

MOBILE_SESSION_DURATION=60
MOBILE_TRUSTED_SESSION_DURATION=480
MOBILE_BIOMETRIC_CHALLENGE_TTL=300

MOBILE_PUSH_ENABLED=true
MOBILE_PUSH_MAX_RETRIES=3
MOBILE_PUSH_RETRY_DELAY=60
MOBILE_PUSH_BATCH_SIZE=100
MOBILE_PUSH_CLEANUP_DAYS=30

MOBILE_FEATURE_BIOMETRIC=true
MOBILE_FEATURE_PUSH=true
# SET EXPLICITLY: advertised to the app in GET /api/mobile/config only;
# keep it consistent with TRADING_ENABLED / MODULES_DISABLED (Basket).
MOBILE_FEATURE_GCU_TRADING=true
MOBILE_FEATURE_P2P_TRANSFERS=true
MOBILE_FEATURE_EXCHANGE=true
MOBILE_FEATURE_LENDING=false
MOBILE_FEATURE_STABLECOINS=false

MOBILE_STALE_DEVICE_DAYS=90
MOBILE_MAX_BIOMETRIC_FAILURES=5
MOBILE_BIOMETRIC_BLOCK_MINUTES=30

# Device attestation (Apple App Attest / Google Play Integrity). Keep false
# until the mobile-supplied challenge is wired through — see config/mobile.php.
MOBILE_ATTESTATION_ENABLED=false

# =============================================================================
# BIOMETRIC JWT (v2.6.0+)
# =============================================================================
BIOMETRIC_JWT_SECRET=
BIOMETRIC_JWT_TTL=300
BIOMETRIC_JWT_STRICT=true
BIOMETRIC_JWT_REVOKED_TTL=24

# =============================================================================
# HSM / KEY MANAGEMENT
# =============================================================================
HSM_ENABLED=true
HSM_PROVIDER=aws
HSM_KEY_ID=
# Defaults to TRUE in config/keymanagement.php — must be explicitly false in
# production or a simulated HSM signs in place of the real cloud HSM.
KEY_MANAGEMENT_DEMO_MODE=false

# =============================================================================
# PRIVACY / ZK
# =============================================================================
# ZK_PROVIDER: keep 'demo' in production. 'railgun' enables the CUSTODIAL
# server-side-seed path (seed derived from app.key) — blocked by ops:verify-env
# in prod, and the custodial shield/unshield/transfer/viewing-key endpoints
# hard-return 501 regardless. Non-custodial privacy is on-device (engine-config).
ZK_PROVIDER=demo
ZK_PROOF_VALIDITY_DAYS=90
PRIVACY_AUDIT_LOGGING=true
POI_RENEWAL_THRESHOLD=30
POI_THRESHOLD_USD=10000
PRIVACY_HUMAN_REVIEW=true
PRIVACY_POOLS_ENABLED=false
PRIVACY_BROADCASTERS_ENABLED=false

MERKLE_PROVIDER=railgun
MERKLE_SYNC_INTERVAL=30
MERKLE_TREE_DEPTH=32

# RAILGUN Privacy Protocol Bridge
# NOTE: these three are the ONLY RAILGUN vars Laravel reads. The Node bridge
# sidecar (infrastructure/railgun-bridge/) needs its OWN .env with the per-chain
# RPC URLs + POI node — Laravel never reads them, so they are easy to miss:
#   ETHEREUM_RPC_URL / POLYGON_RPC_URL / ARBITRUM_RPC_URL / BSC_RPC_URL (a missing
#   one silently SKIPS that chain), RAILGUN_POI_NODE_URL, RAILGUN_ARTIFACTS_DIR,
#   BRIDGE_SECRET (must equal RAILGUN_BRIDGE_SECRET below).
# See infrastructure/railgun-bridge/.env.example. Bridge must run single-instance
# (stateful engine). RAILGUN supports ethereum/polygon/arbitrum/bsc — NOT base.
RAILGUN_BRIDGE_URL=http://127.0.0.1:3100
RAILGUN_BRIDGE_SECRET=
RAILGUN_BRIDGE_TIMEOUT=30

# RAILGUN non-custodial on-device engine (served by GET /api/v1/privacy/engine-config).
# These are PUBLIC infra endpoints the mobile app points its on-device engine at.
# RPC URLs MUST be key-safe (a proxy or keyless endpoint) — never embed an API key,
# the value is returned to the client. See docs/operations/railgun-infra.md.
RAILGUN_WALLET_SOURCE=zelta
RAILGUN_ARTIFACT_BASE_URL=
RAILGUN_POI_NODE_URLS=                # comma-separated; our self-hosted POI aggregator(s)
RAILGUN_BROADCASTER_ENABLED=true
RAILGUN_RPC_ETHEREUM=
RAILGUN_RPC_POLYGON=
RAILGUN_RPC_ARBITRUM=
RAILGUN_RPC_BSC=
# PREFERRED: built-in RPC proxy. Set the per-chain UPSTREAM (real provider URL,
# key included — server-side only, never sent to clients). When set, engine-config
# hands the app a short-lived SIGNED proxy URL instead of the client RPC above.
RAILGUN_RPC_UPSTREAM_ETHEREUM=
RAILGUN_RPC_UPSTREAM_POLYGON=
RAILGUN_RPC_UPSTREAM_ARBITRUM=
RAILGUN_RPC_UPSTREAM_BSC=
RAILGUN_RPC_PROXY_TTL=300             # signed proxy-URL lifetime (seconds)

# WebAuthn / Passkey Configuration
WEBAUTHN_RP_ID=finaegis.com
WEBAUTHN_RP_NAME=FinAegis
WEBAUTHN_ORIGIN=https://finaegis.com

DELEGATED_PROVING_ENABLED=true
DELEGATED_PROVING_MAX_QUEUE=100
DELEGATED_PROVING_TIMEOUT=300
DELEGATED_PROVING_QUEUE=proofs

# =============================================================================
# RELAYER / ERC-4337 — REAL BUNDLER IN PRODUCTION
# =============================================================================
RELAYER_DEFAULT_NETWORK=polygon
RELAYER_FEE_TOKEN=USDC
RELAYER_FEE_MARKUP=0.1
RELAYER_MIN_FEE=0.01
RELAYER_DAILY_LIMIT=100
RELAYER_DAILY_VALUE_LIMIT=1000
BUNDLER_DRIVER=pimlico
BALANCE_PROVIDER=alchemy
BALANCE_CACHE_TTL=30

# Generic gas sponsorship: REST POST /api/v1/relayer/sponsor and GraphQL
# sponsorTransaction. Not used by the mobile app (wallet sends use
# /api/v1/wallet/transactions/*, unaffected). Unset = OFF under
# APP_ENV=production (route 404, mutation error). If enabled, the sender
# must be a smart account / wallet address registered to the caller and
# only execute(USDC|USDT, 0, transfer(to, amount)) on
# WALLET_SEND_EVM_NETWORKS is sponsored.
RELAYER_GENERIC_SPONSOR_ENABLED=false

# Pimlico (ERC-4337 bundler + verifying paymaster).
# PIMLICO_BUNDLER_URL: leave EMPTY. The bundler URL is derived per chain
# (https://api.pimlico.io/v2/{chainId}/rpc, key appended as ?apikey=). A
# pinned URL sends every network's bundler calls to that one chain, so it
# must stay empty while WALLET_SEND_EVM_NETWORKS lists more than one network
# (ops:verify-env warns). Never put the key in it. Provider keys are redacted
# from send errors, logs and API responses.
PIMLICO_API_KEY=
PIMLICO_BUNDLER_URL=
PIMLICO_CHAIN_ID=137
PIMLICO_TIMEOUT=15
PIMLICO_RETRY_COUNT=3

# Wallet send — outbound dispatch + sponsored-send abuse guardrail.
# WALLET_SEND_EVM_NETWORKS: comma-separated EVM networks enabled for SEND.
#   Ethereum L1 is deliberately omitted — its gas is uncapped and we sponsor
#   it. Add 'ethereum' only with a deliberate cost decision.
WALLET_SEND_EVM_NETWORKS=polygon,base,arbitrum
# Per-user / global daily send caps. Counts reset 00:00 UTC. These bound the
# paymaster bill against scripted abuse and viral spikes.
WALLET_SEND_PER_USER_DAILY_LIMIT=30
WALLET_SEND_GLOBAL_DAILY_LIMIT=5000
# Optional value-denominated cap on top of the count caps: total estimated
# USD spent on sponsored gas per UTC day. Spend accumulates at confirmation
# time from recorded per-send fees; when reached, prepares return 429.
# Leave empty to disable. Inspect with: php artisan wallet:sponsorship-spend
WALLET_SPONSORSHIP_DAILY_BUDGET_USD=

# Wallet address registration (POST /api/v1/wallet/addresses).
# WALLET_ADDRESS_OWNERSHIP_VERIFICATION checks that each new address is a
# wallet of the caller's Privy account. "monitor" only logs mismatches.
# "enforce" refuses them and needs PRIVY_APP_SECRET. "off" skips the check.
# Switch to enforce once the monitor logs show that real users pass.
# ops:verify-env warns in production while it is monitor or off, and fails
# enforce without PRIVY_APP_ID and PRIVY_APP_SECRET (PRIVY section below).
WALLET_ADDRESS_OWNERSHIP_VERIFICATION=monitor
WALLET_ADDRESS_MAX_PER_CHAIN=3
# Distinct owner addresses per user for relayer smart accounts.
WALLET_SMART_ACCOUNT_MAX_OWNERS=3
WALLET_ADDRESS_NEW_CLAIMS_PER_HOUR=10
WALLET_INBOUND_SIDE_EFFECTS_PER_ADDRESS_PER_HOUR=120

# Solana fee-payer (sponsor) account. A non-custodial wallet holds SPL tokens
# but no SOL, so it cannot pay its own transaction fee — when this key is set
# the platform sponsor account pays the fee and co-signs every Solana send.
# Leave empty to keep the legacy behaviour (sender pays its own fee, which
# fails for a 0-SOL wallet). Base58-encoded 64-byte ed25519 secret key;
# generate it off-machine and store it only in the secret manager.
WALLET_SOLANA_SPONSOR_SECRET_KEY=
# Alert threshold (lamports) for the hourly sponsor-balance check. 0.1 SOL.
WALLET_SOLANA_SPONSOR_LOW_BALANCE_LAMPORTS=100000000
# Inbound native-SOL transfers below this (in SOL) are treated as dusting /
# address-poisoning spam: recorded for audit but kept out of the activity
# feed and silenced (no push). Token transfers are never filtered.
WALLET_SOLANA_DUST_MIN_INBOUND_SOL=0.001

# Network RPC URLs (Alchemy or public endpoints)
POLYGON_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# Smart Account Factory addresses (deploy or use existing SimpleAccountFactory)
POLYGON_FACTORY_ADDRESS=
BASE_FACTORY_ADDRESS=
ARBITRUM_FACTORY_ADDRESS=

# Paymaster contract addresses
POLYGON_PAYMASTER_ADDRESS=
BASE_PAYMASTER_ADDRESS=
ARBITRUM_PAYMASTER_ADDRESS=

# Alchemy (balance provider + EVM webhooks — signing keys stored in DB)
ALCHEMY_API_KEY=
ALCHEMY_NOTIFY_TOKEN=

# Helius (Solana webhooks, balances + transaction backfill).
# The API key is passed as a query param (?api-key=) — Helius has no
# Authorization-header support.
HELIUS_API_KEY=
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_SECRET=

# =============================================================================
# X402 PROTOCOL — PRODUCTION
# =============================================================================
X402_ENABLED=true
X402_PAY_TO_ADDRESS=          # Your USDC receiving address on Base
X402_DEFAULT_NETWORK=eip155:8453
X402_DEFAULT_ASSET=USDC
X402_MAX_TIMEOUT_SECONDS=60
X402_SETTLE_BEFORE_RESPONSE=true
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_TIMEOUT=30
X402_SELF_HOSTED_FACILITATOR=false
X402_CLIENT_ENABLED=true
X402_CLIENT_SIGNER_KEY_ID=    # HSM key ID for production signing
X402_CLIENT_SIGNER_ADDRESS=   # Your signing wallet address
X402_CLIENT_AUTO_PAY=false    # Require explicit approval in production
X402_CLIENT_MAX_AUTO_PAY=100000
X402_AGENT_DAILY_LIMIT=5000000
X402_REQUIRE_APPROVAL_ABOVE=1000000
X402_PER_TRANSACTION_LIMIT=100000

# =============================================================================
# CARD ISSUANCE (Marqeta)
# =============================================================================
CARD_ISSUER=marqeta
# REQUIRED: Set to production Marqeta API URL (not sandbox)
MARQETA_BASE_URL=
MARQETA_APPLICATION_TOKEN=
MARQETA_ADMIN_ACCESS_TOKEN=
# Card issuer webhooks (/api/webhooks/card-issuer/authorization|settlement|
# transaction): set USERNAME + PASSWORD (Basic Auth) and/or WEBHOOK_SECRET
# (HMAC, X-Marqeta-Webhook-Signature then required). With none set the
# endpoints answer 401 (fail closed). JIT funding uses the real ledger
# balance and holds whenever CARD_ISSUER is not demo; a missing account,
# asset or hold store declines.
MARQETA_WEBHOOK_SECRET=
MARQETA_WEBHOOK_USERNAME=
MARQETA_WEBHOOK_PASSWORD=
CARD_JIT_HOLD_TTL_SECONDS=604800

# FinCard (FinHub BFF, finhub.cloud) — prefunded stored-value virtual cards.
# Set CARD_ISSUER=fincard to activate. Auth is a session-JWT login (no outbound
# request signing on our side). Inbound webhooks are RSA-signed — the platform
# public key is REQUIRED outside local/testing or webhooks are rejected. ops:verify-env
# FAILs when CARD_ISSUER=fincard and any of TENANT_ID/USERNAME/PASSWORD/
# WEBHOOK_PUBLIC_KEY are empty.
# base_url per docs.finhub.cloud: sandbox https://sandbox.finhub.cloud/... ,
# integration https://api-beta.finhub.cloud/... , prod https://api.finhub.cloud/...
FINCARD_BASE_URL=https://api.finhub.cloud/api/v2.1/fincard/virtual
FINCARD_TENANT_ID=
FINCARD_ORG_ID=
FINCARD_USER_ID=
FINCARD_USERNAME=
FINCARD_PASSWORD=
FINCARD_FORWARDED_FROM=zelta
# RSA public key (PEM, or base64-of-PEM, or single-line with \n) from FinCard.
FINCARD_WEBHOOK_PUBLIC_KEY=
FINCARD_DEFAULT_CARD_TYPE_ID=
FINCARD_DEFAULT_COIN_KEY=USDT_TRC20

# Lepo Finance — virtual cards (issuer Interlace, identity checks by SumSub),
# funded from USDC/USDT deposits. Keys and the webhook endpoint are managed in
# the Lepo partner portal (API keys; Endpoints: URL https://<host>/api/v1/webhooks/lepo,
# secret, test delivery). The API key value is shown only once when created.
# ops:verify-env FAILs in production when Lepo is in use (lepo in
# CARD_PROVIDERS_ENABLED, or LEPO_API_KEY set) and LEPO_API_KEY or
# LEPO_WEBHOOK_SECRET is empty, and WARNs without LEPO_CARD_TYPE_ID_VIRTUAL or
# with an empty pilot list. Do not set CARD_ISSUER=lepo: that switch belongs to
# the older JIT card issuers and has no Lepo binding. Tier and card-type ids come from the
# partner tier (GET /api/v2/tiers) — never commit them.
LEPO_BASE_URL=https://api.lepofinance.com/api/v2
LEPO_API_KEY=
LEPO_WEBHOOK_SECRET=
LEPO_CARD_TYPE_ID_VIRTUAL=
LEPO_TIER_ID=
LEPO_TIMEOUT_SECONDS=15

# Card providers (provider-neutral card onboarding, /api/v1/cards/*).
# CARD_PROVIDERS_ENABLED is opt-in (empty = cards not offered). The provider
# is stored on each cardholder, so changing the default never moves existing
# users. While CARD_PROVIDER_LEPO_PILOT_ONLY=true only the users listed in
# CARD_PROVIDER_LEPO_PILOT_USERS (uuids or e-mails, comma-separated) get Lepo
# cards. LEPO_DEPOSIT_NETWORKS: native USDC networks offered for top-ups
# (Arbitrum first: about 3 minutes to credit; Polygon about 25 minutes).
CARD_PROVIDERS_ENABLED=
CARD_PROVIDER_DEFAULT=lepo
CARD_PROVIDER_SELECTION=default
CARD_PROVIDER_LEPO_PILOT_ONLY=true
CARD_PROVIDER_LEPO_PILOT_USERS=
# Identity check: hosted_url opens our page with the SumSub web SDK in the
# app's browser (Lepo must allow this domain in its SumSub WebSDK domain list);
# sumsub_sdk returns a token for the native SumSub SDK instead.
CARD_LEPO_KYC_METHOD=hosted_url
CARD_KYC_RETURN_URL=zelta://cards/kyc-done
CARD_KYC_LINK_MINUTES=30
# Cards one user may hold at once.
CARD_LEPO_MAX_CARDS=1
# Interlace Widget.js for card details; empty = production script.
LEPO_WIDGET_SCRIPT_URL=
# "Add to card" stays off until Lepo confirms the money path.
CARD_TOPUPS_ENABLED=false
CARD_TOPUP_MIN=10.00
CARD_TOPUP_MAX=1000.00
CARD_TOPUP_TTL_MINUTES=60
LEPO_DEPOSIT_NETWORKS=arbitrum,polygon

# =============================================================================
# MOBILE PAYMENT
# =============================================================================
MOBILE_PAYMENT_NETWORKS=SOLANA,TRON
MOBILE_PAYMENT_ASSETS=USDC
MOBILE_PAYMENT_EXPIRY_MINUTES=15
MOBILE_PAYMENT_RECEIPT_CACHE_HOURS=24
MOBILE_PAYMENT_IDEMPOTENCY_QUEUE_MINUTES=30
MOBILE_PAYMENT_DEMO_MODE=false

# =============================================================================
# REGTECH / REGULATORY
# =============================================================================
REGTECH_ENABLED=true
REGTECH_DEMO_MODE=false
SOC2_DEMO_MODE=false
REGTECH_ML_ENABLED=true
REGTECH_ML_MODEL_VERSION=1.0.0

# GoPlus Security API (free tier, address screening)
# Get credentials at https://console.gopluslabs.io
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Chainalysis Sanctions Screening (paid, optional)
CHAINALYSIS_API_KEY=
CHAINALYSIS_ENABLED=false

# AI services (config/ai.php) — demo mode defaults to TRUE; must be off in prod
AI_DEMO_MODE=false

# =============================================================================
# TENANCY
# =============================================================================
TENANCY_CENTRAL_CONNECTION=mariadb
TENANCY_TEMPLATE_CONNECTION=mariadb
TENANCY_CENTRAL_DOMAINS=api.your-domain.com

# =============================================================================
# EVENT STORE
# =============================================================================
EVENT_STORE_ARCHIVAL_ENABLED=true
EVENT_STORE_RETENTION_DAYS=365
EVENT_STORE_ARCHIVAL_BATCH_SIZE=1000
EVENT_STORE_COMPACTION_ENABLED=false
EVENT_STORE_KEEP_LATEST=100
EVENT_STORE_PARTITION_STRATEGY=none
EVENT_STORE_GROWTH_RATE_THRESHOLD=10000

# =============================================================================
# ISO 20022 (v7.2.0+)
# =============================================================================
ISO20022_ENABLED=false
ISO20022_FAMILIES=pain,pacs,camt

# =============================================================================
# OPEN BANKING PSD2 (v7.2.0+)
# =============================================================================
OPEN_BANKING_ENABLED=false
OPEN_BANKING_STANDARD=berlin_group

# =============================================================================
# ISO 8583 (v7.2.0+)
# =============================================================================
ISO8583_ENABLED=false

# =============================================================================
# US PAYMENT RAILS (v7.3.0+)
# =============================================================================
ACH_ENABLED=false
FEDWIRE_ENABLED=false
RTP_ENABLED=false
FEDNOW_ENABLED=false

# =============================================================================
# INTERLEDGER (v7.3.0+)
# =============================================================================
ILP_ENABLED=false

# =============================================================================
# LEDGER (v7.4.0+)
# =============================================================================
LEDGER_DRIVER=eloquent

# =============================================================================
# MICROFINANCE (v7.5.0+)
# =============================================================================
MFI_ENABLED=false

# =============================================================================
# STRIPE / PAYMENT PROCESSORS (shared across ramp, KYC checkout, cards)
# =============================================================================
STRIPE_SECRET=
# Stripe Crypto Onramp (canonical) + legacy alias. The new name wins if both are set.
STRIPE_CRYPTO_ONRAMP_WEBHOOK_SECRET=
STRIPE_BRIDGE_WEBHOOK_SECRET=
STRIPE_KYC_WEBHOOK_SECRET=
# Plan B Slice 1 — Stripe subscription webhook secret (separate rotation
# from the legacy CGO/KYC secrets). Endpoint: POST /webhooks/stripe/subscriptions.
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=

# KYC / TrustCert verification fees. OFF by default — verification is free
# and the pay endpoints (wallet/card/IAP) are closed. Only enable once the
# Play Billing IAP rail is production-ready (charging for a digital service
# outside Play Billing risks Android store rejection).
TRUSTCERT_VERIFICATION_FEES_ENABLED=false

# Plan B Slice 5 — Stripe Cards (waitlist deposit) webhook secret. Distinct
# from STRIPE_SUBSCRIPTION_WEBHOOK_SECRET so it can rotate independently.
# Endpoint: POST /webhooks/stripe/cards.
STRIPE_CARDS_WEBHOOK_SECRET=
# Plan B Backend-Q1 — pinned Stripe API version (consumed by Cashier and
# Stripe-bridge clients via config('services.stripe.api_version')).
STRIPE_API_VERSION=2025-04-30.basil
# Plan B §1 — Stripe Price IDs for Pro plans. Required for /api/v1/subscription/*
# to function; without them the plan-resolution returns ERR_SUB_002.
STRIPE_PRICE_MONTHLY_PRO=
STRIPE_PRICE_ANNUAL_PRO=
# Plan B Backend-Q5 — HMAC pepper for trial-card fingerprint hashing.
# Rotate by re-hashing all trial_card_fingerprints rows in one transaction.
TRIAL_FINGERPRINT_PEPPER=
# Plan B Slice 3 — HMAC-SHA256 pepper for price_quotes tamper-evidence signing.
# Generate with: openssl rand -hex 32
# ROTATION WARNING: rotating this value invalidates ALL live price_quotes rows
# (their stored signatures will fail verification at redemption time). Coordinate
# rotation with a `pricing:purge-quotes --dry-run` then a full quote-TTL drain
# window before rotating. Never rotate without a maintenance window.
PRICING_QUOTE_PEPPER=
# Plan B Q14 — version of the EU withdrawal-consent text shown at checkout.
# Bump when copy changes; old version stays usable for dispute lookups.
SUBSCRIPTION_CONSENT_VERSION=1

# =============================================================================
# IAP — Apple App Store + Google Play (Plan B Slice 2)
# =============================================================================
# Bundle ID expected inside Apple StoreKit 2 JWS payloads.
APPLE_BUNDLE_ID=app.zelta
# SECURITY: set to true ONLY for staging environments where the bundled
# Apple Root CA G3 certificate has been intentionally removed or replaced.
# When true, the verifier accepts JWS payloads without validating the x5c
# chain — any authenticated user could forge a receipt and unlock Pro.
# NEVER enable in production. Defaults to false so production fails closed.
APPLE_JWS_VERIFICATION_BYPASS=false
# Apple Root CA G3 used to chain-validate StoreKit 2 JWS receipts. The cert
# is bundled at storage/app/apple/AppleRootCA-G3.cer (DER format). Override
# only for staging environments with a different cert.
# APPLE_ROOT_CA_PATH=/var/www/html/storage/app/apple/AppleRootCA-G3.cer
# Comma-separated SHA-256 fingerprints (hex, no separators) of acceptable
# root CAs. Defaults to the bundled Apple Root CA G3. Add a second value
# during root rollovers.
# APPLE_ROOT_CA_FINGERPRINTS=63343ABFB89A6A03EBB57E9B3F5FA7BE7C4F5C756F3017B3A8C488C3653E9179
# App Store Connect IAP product IDs (must match EXPO_PUBLIC_PRO_*_SKU on mobile).
APPLE_PRODUCT_MONTHLY_PRO=zelta_pro_monthly
APPLE_PRODUCT_ANNUAL_PRO=zelta_pro_annual
# Google Play package name + product IDs.
GOOGLE_PACKAGE_NAME=app.zelta
GOOGLE_PRODUCT_MONTHLY_PRO=zelta_pro_monthly
GOOGLE_PRODUCT_ANNUAL_PRO=zelta_pro_annual
# Recommended: path to the Google service account JSON key file (kept outside
# webroot). Alternative: GOOGLE_PLAY_SERVICE_ACCOUNT_JSON with raw or base64
# JSON content (use only when file mount is impractical).
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Audience claim verified on Pub/Sub push to /webhooks/google/play.
GOOGLE_PLAY_WEBHOOK_AUDIENCE=https://api.zelta.app
# IAP_RECEIPT_PEPPER: ONE-WAY ROTATION CAVEAT — previously-scrubbed receipts
# cannot be re-hashed after rotation (raw originalTransactionId was nulled at
# pseudonymisation time). Rotate only on confirmed compromise; expect manual
# ops resolution for webhook matches against pre-rotation receipts.
# Generate with: openssl rand -base64 32
IAP_RECEIPT_PEPPER=
# Mobile deep-link return URLs for KYC Checkout. Override per env if you
# need a non-default scheme (e.g. demo or staging build).
# STRIPE_KYC_SUCCESS_URL=zelta://trustcert/payment-return?status=success&session={CHECKOUT_SESSION_ID}
# STRIPE_KYC_CANCEL_URL=zelta://trustcert/payment-return?status=cancel
# Provider selection is via RAMP_PROVIDER below — no separate enable flag.
# v1 default: Bridge.xyz bank-rail integration (ACH + SEPA + SEPA Instant).
# The legacy `stripe_bridge` value is still accepted with a deprecation
# warning and maps to stripe_crypto_onramp (card-payment fallback).
RAMP_PROVIDER=bridge

# Bridge.xyz credentials
BRIDGE_API_KEY=
# Per-endpoint RSA public key from the Bridge dashboard webhook (PEM or base64-of-PEM)
# used to verify X-Webhook-Signature. Required for the current platform; not a secret.
BRIDGE_WEBHOOK_PUBLIC_KEY=
# Legacy HMAC shared secret — leave blank on the current "Bridge by Stripe" platform.
BRIDGE_WEBHOOK_SECRET=
BRIDGE_API_BASE_URL=https://api.bridge.xyz
BRIDGE_DEFAULT_DEV_FEE_BPS=75

# Ondato identity verification (TrustCert KYC). Leave empty when Ondato is not
# used. When ONDATO_APPLICATION_ID or ONDATO_SECRET is set, this secret is
# required: outside local and testing, Ondato webhooks without a valid
# X-Ondato-Signature are refused (401), and ops:verify-env fails without it.
ONDATO_WEBHOOK_SECRET=

# HyperSwitch payment orchestration (EXPERIMENTAL — default OFF). When enabled,
# card deposits route through HyperSwitch and are credited via its webhook.
# Requires a running HyperSwitch deployment + keys. See config/hyperswitch.php.
HYPERSWITCH_ENABLED=false
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_API_KEY=
HYPERSWITCH_PUBLISHABLE_KEY=
HYPERSWITCH_WEBHOOK_SECRET=
HYPERSWITCH_PROFILE_ID=
HYPERSWITCH_RETURN_URL=

# Onramper (legacy ramp provider, prefer stripe_crypto_onramp or bridge for production)
ONRAMPER_API_KEY=
ONRAMPER_SECRET_KEY=
ONRAMPER_BASE_URL=https://api.onramper.com
ONRAMPER_ENABLED=false
ONRAMPER_SUCCESS_REDIRECT_URL=

# =============================================================================
# MCP Server (v7.11.0)
# =============================================================================
# Public Model Context Protocol surface at https://mcp.zelta.app/mcp.
# OAuth AS is the existing Passport instance at MCP_AUTH_SERVER.
MCP_ENABLED=true
MCP_HOST=mcp.zelta.app
MCP_AUTH_SERVER=https://zelta.app
MCP_RESOURCE_URI=https://mcp.zelta.app
MCP_SERVER_NAME=Zelta
MCP_SERVER_VERSION=0.1.0

# Per-token spending limit defaults; the consent screen lets the user override.
MCP_DEFAULT_DAILY_LIMIT_MINOR=50000
MCP_DEFAULT_DAILY_LIMIT_CURRENCY=USD

# Flat per-message charge (minor units, USD) reserved against the daily
# spending limit for every sms.send call. Default 10 = $0.10.
# sms.send (MCP and POST /api/v1/sms/send) only sends while SMS_ENABLED is
# true — unset = OFF under APP_ENV=production (503). Unpaid sends (REST with
# a Sanctum token, and every MCP sms.send call) are limited per user
# (SMS_SEND_PER_USER_PER_DAY, default 50, shared by REST and MCP; REST also
# SMS_SEND_PER_USER_PER_MINUTE, default 5) and by a global daily cap across
# all users (SMS_SEND_GLOBAL_PER_DAY, default 500; 429 ERR_SMS_001 until
# 00:00 UTC). With MPP_ENABLED=true and the route monetized, a REST request
# carrying an MPP Payment credential of at least SMS_MIN_PAID_PRICE_USDC pays instead
# and skips these limits. The daily limits count billed SMS parts. Paid sends
# have their own daily ceiling per user or payer (SMS_PAID_SEND_PER_USER_PER_DAY).
MCP_SMS_PRICE_MINOR=10
SMS_ENABLED=false
SMS_SEND_PER_USER_PER_MINUTE=5
SMS_SEND_PER_USER_PER_DAY=50
SMS_SEND_GLOBAL_PER_DAY=500
SMS_PAID_SEND_PER_USER_PER_DAY=500
# Smallest payment (atomic USDC; 10000 = $0.01) that counts as a paid send.
SMS_MIN_PAID_PRICE_USDC=10000

# Idempotency cache. Lock TTL must be >= the slowest payment rail (Lightning
# HTLC, congested L1 confirmation) — too short lets a stalled first call's
# concurrent retry double-charge. 300s is conservative.
MCP_IDEMPOTENCY_STORE=redis
MCP_IDEMPOTENCY_LOCK_TTL_SECONDS=300

# Streamable-HTTP SSE — keep OFF under PHP-FPM (long-lived SSE pins a worker
# for the connection lifetime; under load that exhausts the pool). Flip to
# true only under Octane/Swoole or a dedicated SSE FPM pool.
MCP_SSE_ENABLED=false
MCP_SSE_HEARTBEAT_SECONDS=25

# DCR brand-name reservation — comma-separated, case-insensitive substrings
# rejected from client_name to block obvious phishing on the consent screen.
MCP_DCR_RESERVED_NAMES=zelta,finaegis,anthropic,claude,openai,gpt,stripe,paysera,visa,mastercard,official,admin,system,support,security

# Per-tool kill switches (flip to false to remove from the public catalog
# without redeploy: `php artisan config:cache && supervisorctl restart`).
# account.create, payment.transfer and exchange.trade move internal ledger
# balances and sms.send sends SMS billed to the platform: they default to
# OFF under APP_ENV=production (use the literal false/true; config/mcp.php
# does not cast these). Every other tool defaults to true.
# A .env built from the v7.16.0 template or older sets these four to true.
# An explicit true overrides the production-off default, so change them to
# false. exchange.trade also needs TRADING_ENABLED=true.
MCP_TOOL_ACCOUNT_BALANCE=true
MCP_TOOL_ACCOUNT_CREATE=false
MCP_TOOL_PAYMENT_STATUS=true
MCP_TOOL_PAYMENT_TRANSFER=false
MCP_TOOL_TRANSACTIONS_QUERY=true
MCP_TOOL_SPENDING_ANALYSIS=true
MCP_TOOL_EXCHANGE_QUOTE=true
MCP_TOOL_EXCHANGE_TRADE=false
MCP_TOOL_RAMP_START=true
MCP_TOOL_RAMP_STATUS=true
MCP_TOOL_MPP_DISCOVERY=true
MCP_TOOL_SMS_SEND=false
# With APP_ENV=production, MCP_TOOL_SMS_SEND=true fails ops:verify-env
# unless MCP_TOOL_SMS_SEND_ACKNOWLEDGED=true confirms it.
# MCP_TOOL_SMS_SEND_ACKNOWLEDGED=false
MCP_TOOL_WALLET_ADDRESSES=true
MCP_TOOL_WALLET_ACTIVITY=true

# =============================================================================
# PRIVY (NON-CUSTODIAL WALLET PROVIDER)
# =============================================================================
# Privy issues session JWTs that the mobile app forwards to
# POST /api/v1/auth/privy-login to exchange for a Sanctum token.
# Privy (non-custodial wallet provider)
PRIVY_APP_ID=
# Server-side secret: also used to check registered wallet addresses against
# the user's Privy wallets (WALLET_ADDRESS_OWNERSHIP_VERIFICATION).
PRIVY_APP_SECRET=
PRIVY_JWKS_URL=

# Optional: override Privy REST API base URL (defaults to https://auth.privy.io).
# Used for server-to-server email OTP via POST /api/v1/passwordless/{init,authenticate}.
# PRIVY_API_BASE_URL=https://auth.privy.io

# Optional: web origin sent to Privy as the Origin header on REST calls.
# Must match a URL added to the Privy dashboard "Allowed Origins" list, or
# Privy returns 403 "Must specify origin". Defaults to APP_URL when unset —
# set this explicitly when web /login lives on a different host than the API.
# PRIVY_WEB_ORIGIN=https://app.your-domain.com

# Web Privy email-OTP login. When true, /login renders Privy email-OTP
# (replacing legacy email+password Jetstream) and signup happens on first
# successful OTP.
#
# This flag is independent of the Privy dashboard "auto-create wallet on
# login" setting. Flipping the dashboard auto-create OFF (to mitigate
# Privy MAU billing on speculative web signups) requires the mobile
# defensive ethereum.create() / solana.create() useEffect to be deployed
# to production first — mobile commit 6a1744b on feat/wallet-privy-
# noncustodial. Confirm with mobile dev that the build is on prod before
# flipping the dashboard config; the MCP_WEB_PRIVY_LOGIN flag itself can
# be toggled freely.
MCP_WEB_PRIVY_LOGIN=false

# =============================================================================
# POST-DEPLOYMENT
# =============================================================================
# After deployment, run: php artisan l5-swagger:generate
# This generates the OpenAPI spec for /api/documentation
